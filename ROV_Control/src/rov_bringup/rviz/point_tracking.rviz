Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid 0.1m
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 40
      Reference Frame: map
    - Class: rviz_default_plugins/Odometry
      Name: Actual AUV
      Enabled: true
      Keep: 1
      Topic:
        Value: /tracking/odometry
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 1
      Shape: Arrow
      Position Tolerance: 0.001
      Angle Tolerance: 0.01
    - Class: rviz_default_plugins/Path
      Name: Planned path - green
      Enabled: true
      Color: 0; 255; 100
      Line Style: Lines
      Topic:
        Value: /tracking/planned_path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
    - Class: rviz_default_plugins/Path
      Name: Actual path - blue
      Enabled: true
      Color: 50; 170; 255
      Line Style: Lines
      Topic:
        Value: /tracking/actual_path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
    - Class: rviz_default_plugins/Pose
      Name: Reference - orange
      Enabled: true
      Color: 255; 170; 0
      Shape: Arrow
      Shaft Length: 0.08
      Shaft Radius: 0.006
      Head Length: 0.03
      Head Radius: 0.015
      Topic:
        Value: /tracking/reference_pose
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 1
    - Class: rviz_default_plugins/Pose
      Name: Goal - red
      Enabled: true
      Color: 255; 70; 70
      Shape: Arrow
      Shaft Length: 0.08
      Shaft Radius: 0.008
      Head Length: 0.03
      Head Radius: 0.015
      Topic:
        Value: /tracking/goal
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.5
      Focal Point:
        X: 1.1
        Y: 1.3
        Z: -0.2
      Pitch: 1.0
      Yaw: 0.8
Window Geometry:
  Width: 1100
  Height: 760
